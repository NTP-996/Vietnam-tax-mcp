# Copy to .env for `make run`. Development defaults; nothing here is a secret.
APP_ENV=development
MCP_PORT=8090
# Required in production: the public https URL the server is reached at.
MCP_PUBLIC_URL=
# Packs with legal_doc: FIXTURE load only outside production.
MCP_ALLOW_FIXTURE_PACKS=true
MCP_RATE_PER_MIN=300
MCP_MAX_INFLIGHT=32
# An empty password leaves /internal/stats unmounted.
STATS_USER=ops
STATS_PASSWORD=
# Read only by deploy/compose.yml on the VPS.
MCP_HOST=mcp.example.invalid
ACME_EMAIL=ops@example.invalid
